import React, { useState, useEffect } from 'react';
import { supabase } from '../lib/supabase';
import { config } from '../config';

const TournamentInitializer = ({ onTournamentCreated }) => {
  const [participants, setParticipants] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  // Load existing participants from database
  useEffect(() => {
    loadParticipants();
  }, []);

  const loadParticipants = async () => {
    try {
      const { data, error } = await supabase
        .from('participants')
        .select('*')
        .eq('tournament_id', config.TOURNAMENT_ID)
        .order('seed_number');

      if (error) throw error;
      setParticipants(data || []);
    } catch (err) {
      console.error('Error loading participants:', err);
    }
  };

  // Standard tournament seeding for 64 players (Round 1 bracket positions)
  const TOURNAMENT_SEEDING = [
    1, 64, 32, 33, 16, 49, 17, 48, 8, 57, 25, 40, 9, 56, 24, 41,
    4, 61, 29, 36, 13, 52, 20, 45, 5, 60, 28, 37, 12, 53, 21, 44,
    2, 63, 31, 34, 15, 50, 18, 47, 7, 58, 26, 39, 10, 55, 23, 42,
    3, 62, 30, 35, 14, 51, 19, 46, 6, 59, 27, 38, 11, 54, 22, 43
  ];

  const generateSampleParticipants = () => {
    const sampleData = [];
    for (let i = 1; i <= 64; i++) {
      sampleData.push({
        name: `Player ${i}`,
        rollNumber: `CS${String(i).padStart(3, '0')}`,
        email: `player${i}@college.edu`
      });
    }
    setParticipants(sampleData.map((p, index) => ({ ...p, seed_number: TOURNAMENT_SEEDING[index] })));
    setError('');
  };

  const importFromCSV = (event) => {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const csv = e.target.result;
        const lines = csv.split('\n').filter(line => line.trim());
        
        if (lines.length < 65) { // Header + 64 participants
          setError('CSV must contain exactly 64 participants');
          return;
        }

        const imported = [];
        // Skip header row
        for (let i = 1; i <= 64; i++) {
          const line = lines[i]?.trim();
          if (!line) continue;

          const [name, rollNumber, email] = line.split(',').map(field => field.trim().replace(/"/g, ''));
          if (name && rollNumber && email) {
            imported.push({ name, rollNumber, email });
          }
        }

        if (imported.length !== 64) {
          setError('CSV must contain exactly 64 valid participants');
          return;
        }

        // Apply tournament seeding
        const seededParticipants = imported.map((participant, index) => ({
          ...participant,
          seed_number: TOURNAMENT_SEEDING[index]
        }));

        setParticipants(seededParticipants);
        setError('');
      } catch (err) {
        setError('Error reading CSV file: ' + err.message);
      }
    };
    reader.readAsText(file);
  };

  const initializeTournament = async () => {
    if (participants.length !== 64) {
      setError('Exactly 64 participants required');
      return;
    }

    setLoading(true);
    setError('');

    try {
      // Clear existing data
      await supabase.from('bracket_positions').delete().eq('tournament_id', config.TOURNAMENT_ID);
      await supabase.from('matches').delete().eq('tournament_id', config.TOURNAMENT_ID);
      await supabase.from('participants').delete().eq('tournament_id', config.TOURNAMENT_ID);

      // Insert participants with proper seeding
      const participantsData = participants.map(participant => ({
        tournament_id: config.TOURNAMENT_ID,
        name: participant.name,
        roll_number: participant.rollNumber,
        email: participant.email,
        seed_number: participant.seed_number,
        status: 'active',
        current_round: 1,
        total_wins: 0
      }));

      const { data: insertedParticipants, error: participantsError } = await supabase
        .from('participants')
        .insert(participantsData)
        .select('id, seed_number');

      if (participantsError) throw participantsError;

      // Create Round 1 matches
      await createRound1Matches(insertedParticipants);
      
      // Reload participants from database
      await loadParticipants();

      if (onTournamentCreated) {
        onTournamentCreated({ id: config.TOURNAMENT_ID, name: config.TOURNAMENT_NAME });
      }

      alert('Tournament initialized successfully!');
    } catch (error) {
      setError('Failed to initialize tournament: ' + error.message);
    } finally {
      setLoading(false);
    }
  };  const createRound1Matches = async (insertedParticipants) => {
    try {
      // Get round 1 ID
      const { data: round1 } = await supabase
        .from('rounds')
        .select('id')
        .eq('tournament_id', config.TOURNAMENT_ID)
        .eq('round_number', 1)
        .single();

      if (!round1) {
        throw new Error('Round 1 not found');
      }

      // Clear existing matches and bracket positions
      await supabase.from('bracket_positions').delete().eq('tournament_id', config.TOURNAMENT_ID);
      await supabase.from('matches').delete().eq('tournament_id', config.TOURNAMENT_ID);

      // Sort participants by seed number to ensure proper pairing
      const sortedParticipants = insertedParticipants.sort((a, b) => a.seed_number - b.seed_number);

      // Create 32 matches for Round 1 (pair participants by seed)
      const matchesData = [];
      const bracketPositionsData = [];

      for (let i = 0; i < 32; i++) {
        const player1 = sortedParticipants[i * 2];
        const player2 = sortedParticipants[i * 2 + 1];
        
        const matchData = {
          tournament_id: config.TOURNAMENT_ID,
          round_id: round1.id,
          round_number: 1,
          match_number: i + 1,
          player1_id: player1.id,
          player2_id: player2.id,
          status: 'scheduled',
          match_type: 'regular'
        };

        matchesData.push(matchData);

        // Create bracket position for this match
        bracketPositionsData.push({
          tournament_id: config.TOURNAMENT_ID,
          round_number: 1,
          position_x: 50, // Left side of bracket
          position_y: 50 + (i * 120), // Vertical spacing
          column_index: 0,
          row_index: i
        });
      }

      console.log('Creating matches with data:', matchesData.slice(0, 2)); // Debug first 2 matches

      // Insert matches
      const { data: insertedMatches, error: matchesError } = await supabase
        .from('matches')
        .insert(matchesData)
        .select('id');

      if (matchesError) {
        throw new Error(`Failed to create matches: ${matchesError.message}`);
      }

      console.log('✅ Matches created:', insertedMatches.length);

      // Add match IDs to bracket positions
      const bracketPositionsWithMatchIds = bracketPositionsData.map((pos, index) => ({
        ...pos,
        match_id: insertedMatches[index].id
      }));

      // Insert bracket positions
      const { error: positionsError } = await supabase
        .from('bracket_positions')
        .insert(bracketPositionsWithMatchIds);

      if (positionsError) {
        console.warn('Bracket positions creation failed:', positionsError.message);
        // Don't throw error for positions, matches are more important
      }

      console.log('✅ Round 1 matches and bracket positions created');
    } catch (error) {
      console.error('Failed to create Round 1 matches:', error);
      throw error;
    }
  };

  const importFromCSV = (event) => {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      const csv = e.target.result;
      const lines = csv.split('\n');
      const imported = [];

      // Skip header row, start from index 1
      for (let i = 1; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) continue;

        const [name, rollNumber, email] = line.split(',').map(field => field.trim().replace(/"/g, ''));
        if (name && rollNumber && email) {
          // Validate email format
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            setError(`Invalid email format: ${email} at line ${i + 1}`);
            return;
          }

          imported.push({
            id: Date.now() + i,
            name,
            rollNumber,
            email,
            seedNumber: imported.length + 1
          });
        }
      }

      if (imported.length === 0) {
        setError('No valid participants found in CSV. Expected format: name,roll_number,email');
        return;
      }

      if (imported.length > 64) {
        setError(`Too many participants: ${imported.length}. Tournament 2k25 supports exactly 64 participants.`);
        return;
      }

      if (imported.length < 64) {
        setError(`Not enough participants: ${imported.length}. Tournament 2k25 requires exactly 64 participants.`);
        return;
      }

      // Check for duplicate roll numbers and emails
      const rollNumbers = imported.map(p => p.rollNumber);
      const emails = imported.map(p => p.email);
      
      if (new Set(rollNumbers).size !== rollNumbers.length) {
        setError('Duplicate roll numbers found in CSV');
        return;
      }

      if (new Set(emails).size !== emails.length) {
        setError('Duplicate emails found in CSV');
        return;
      }

      setParticipants(imported);
      setError('');
      console.log(`✅ Successfully imported ${imported.length} participants from CSV`);
    };

    reader.readAsText(file);
    // Clear the file input
    event.target.value = '';
  };

  return (
    <div className="tournament-initializer p-6 bg-white rounded-lg shadow-lg max-w-4xl mx-auto">
      <h2 className="text-2xl font-bold mb-6 text-gray-800">Initialize Tournament 2k25</h2>
      
      <div className="bg-blue-50 border border-blue-200 p-4 rounded-lg mb-6">
        <h3 className="text-lg font-medium text-blue-800 mb-2">Tournament Requirements</h3>
        <ul className="text-sm text-blue-700 space-y-1">
          <li>• Exactly <strong>64 participants</strong> required</li>
          <li>• CSV format: <code>name,roll_number,email</code></li>
          <li>• All roll numbers and emails must be unique</li>
          <li>• Tournament will create 32 Round 1 matches automatically</li>
        </ul>
      </div>
      
      {error && (
        <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          {error}
        </div>
      )}

      {/* Tournament Settings */}
      <div className="mb-6">
        <label className="block text-sm font-medium text-gray-700 mb-2">
          Tournament Name (Fixed)
        </label>
        <input
          type="text"
          value={config.TOURNAMENT_NAME}
          disabled
          className="w-full px-3 py-2 border border-gray-300 rounded bg-gray-100 text-gray-600"
        />
        <p className="text-sm text-gray-500 mt-1">Tournament name is fixed for Tournament 2k25</p>
      </div>

      {/* Quick Actions */}
      <div className="mb-6 flex flex-wrap gap-4">
        <button
          onClick={generateSampleParticipants}
          className="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded transition-colors duration-200"
        >
          Generate 64 Sample Participants
        </button>
        
        <label className="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded cursor-pointer transition-colors duration-200">
          Import 64 Participants from CSV
          <input
            type="file"
            accept=".csv"
            onChange={importFromCSV}
            className="hidden"
          />
        </label>
        
        <button
          onClick={() => setParticipants([])}
          className="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded transition-colors duration-200"
        >
          Clear All
        </button>
      </div>

      {/* Add Participant Form */}
      <div className="mb-6 bg-gray-50 p-4 rounded-lg">
        <h3 className="text-lg font-medium mb-3">Add Participant</h3>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <input
            type="text"
            placeholder="Full Name"
            value={newParticipant.name}
            onChange={(e) => setNewParticipant({...newParticipant, name: e.target.value})}
            className="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <input
            type="text"
            placeholder="Roll Number"
            value={newParticipant.rollNumber}
            onChange={(e) => setNewParticipant({...newParticipant, rollNumber: e.target.value})}
            className="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <input
            type="email"
            placeholder="Email"
            value={newParticipant.email}
            onChange={(e) => setNewParticipant({...newParticipant, email: e.target.value})}
            className="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button
            onClick={addParticipant}
            className="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded transition-colors duration-200"
          >
            Add
          </button>
        </div>
      </div>

      {/* Participants List */}
      <div className="mb-6">
        <h3 className="text-lg font-medium mb-3">
          Participants ({participants.length})
        </h3>
        
        {participants.length === 0 ? (
          <p className="text-gray-500 text-center py-8">
            No participants added yet. Add participants manually or generate sample data.
          </p>
        ) : (
          <div className="max-h-96 overflow-y-auto border border-gray-200 rounded-lg">
            <table className="w-full">
              <thead className="bg-gray-50 sticky top-0">
                <tr>
                  <th className="px-4 py-2 text-left text-sm font-medium text-gray-700">Seed</th>
                  <th className="px-4 py-2 text-left text-sm font-medium text-gray-700">Name</th>
                  <th className="px-4 py-2 text-left text-sm font-medium text-gray-700">Roll Number</th>
                  <th className="px-4 py-2 text-left text-sm font-medium text-gray-700">Email</th>
                  <th className="px-4 py-2 text-left text-sm font-medium text-gray-700">Action</th>
                </tr>
              </thead>
              <tbody>
                {participants.map((participant, index) => (
                  <tr key={participant.id} className="border-b border-gray-200 hover:bg-gray-50">
                    <td className="px-4 py-2 text-sm">{participant.seedNumber}</td>
                    <td className="px-4 py-2 text-sm font-medium">{participant.name}</td>
                    <td className="px-4 py-2 text-sm">{participant.rollNumber}</td>
                    <td className="px-4 py-2 text-sm">{participant.email}</td>
                    <td className="px-4 py-2">
                      <button
                        onClick={() => removeParticipant(index)}
                        className="text-red-600 hover:text-red-800 text-sm"
                      >
                        Remove
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* Create Tournament Button */}
      <div className="text-center">
        <button
          onClick={createTournament}
          disabled={loading || participants.length !== 64}
          className="bg-purple-600 hover:bg-purple-700 disabled:bg-gray-400 disabled:cursor-not-allowed text-white px-8 py-3 rounded-lg text-lg font-medium transition-colors duration-200"
        >
          {loading ? 'Initializing Tournament 2k25...' : 'Initialize Tournament 2k25'}
        </button>
        
        <p className="text-sm text-gray-600 mt-2">
          <span className={participants.length === 64 ? 'text-green-600 font-medium' : 'text-red-600'}>
            Current: {participants.length}/64 participants
          </span>
          <br />
          {participants.length === 64 ? (
            <span className="text-green-600">✅ Ready to initialize tournament!</span>
          ) : (
            <span className="text-red-600">⚠️ Need exactly 64 participants</span>
          )}
        </p>
      </div>
    </div>
  );
};

export default TournamentInitializer;